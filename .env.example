# Indirizzo pubblico del sito (senza / finale)
NEXT_PUBLIC_SITE_URL=https://alanabeauty.it

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (carte, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (developer.paypal.com → Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Email transazionali (resend.com, dominio alanabeauty.it verificato)
RESEND_API_KEY=
EMAIL_FROM="Alana Beauty <ordini@alanabeauty.it>"
# Dove arrivano gli avvisi per la titolare (nuovo ordine, scorte minime, resi)
ADMIN_EMAIL=
